# Copy this file to ".env" and fill in your own values.
# Never commit your real .env file. Never put a real key in this example file.

# Your Groq API key (get one from https://console.groq.com/keys)
GROQ_API_KEY=put_your_groq_api_key_here

# The Groq model to use for answers.
# Groq's available models change over time, so confirm the exact name in your
# own account at https://console.groq.com/docs/models and paste a model that
# is enabled there. A common production example is shown below.
GROQ_MODEL=llama-3.3-70b-versatile
